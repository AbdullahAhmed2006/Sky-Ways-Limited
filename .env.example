# SkyWays Django Project - Environment Variables Template
# Copy this file to .env locally or set these variables in your Vercel Dashboard project settings.

# Django Security Key (Generate a random string for production)
DJANGO_SECRET_KEY=django-insecure-replace-this-with-a-real-secret-key-in-production

# Debug Mode ("True" for local development, "False" for production on Vercel)
DJANGO_DEBUG=False

# Allowed Hosts (space-separated list of hostnames or domain names)
DJANGO_ALLOWED_HOSTS=.vercel.app localhost 127.0.0.1

# Supabase PostgreSQL Database URL
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Note: Use the Transaction Pooler URL (port 6543) or Direct Connection (port 5432) from your Supabase Dashboard
DATABASE_URL=postgresql://postgres:your_password@db.your_supabase_ref.supabase.co:5432/postgres
